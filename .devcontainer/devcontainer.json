{
    "name": "finance-manager-devcontainer",
    "dockerComposeFile": "../docker/dev/docker-compose.yml",
    "service": "api",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "charliermarsh.ruff"
            ]
        }
    },
    "remoteEnv": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
    },
    "runServices": [
        "api"
    ],
    "forwardPorts": [
        8000
    ],
    "portsAttributes": {
        "8000": {
            "label": "FinanceManagerAPI"
        }
    },
    "mounts": [
        "source=${env:HOME}/.ssh,target=/home/appuser/.ssh,type=bind",
        "source=${env:HOME}/.gitconfig,target=/home/appuser/.gitconfig,type=bind"
    ]
}